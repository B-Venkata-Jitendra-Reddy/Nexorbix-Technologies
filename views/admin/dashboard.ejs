<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="NexOrbiX Admin Dashboard">

  <title><%= title %> | NexOrbiX</title>


  <!-- Bootstrap -->
  <link rel="stylesheet" href="/admin/assets/css/bootstrap.min.css">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="/admin/assets/vendors/bootstrap-icons/bootstrap-icons.css">

  <!-- AdminHMD Style -->
  <link rel="stylesheet" href="/admin/assets/css/style.css">

</head>


<body>


  <div class="admin-shell">


    <!-- SIDEBAR BACKDROP -->
    <div class="sidebar-backdrop" data-sidebar-close></div>


    <!-- ===================================== -->
    <!-- SIDEBAR -->
    <!-- ===================================== -->

    <aside class="admin-sidebar" id="adminSidebar" aria-label="Main navigation">


      <!-- SIDEBAR HEADER -->
      <div class="sidebar-header">

        <a class="brand-mark" href="/admin/dashboard" aria-label="NexOrbiX dashboard">

          <span class="brand-icon">

            <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>

          </span>


          <span class="brand-copy">

            <span class="brand-title">
              NexOrbiX
            </span>

            <span class="brand-subtitle">
              Admin Dashboard
            </span>

          </span>

        </a>

      </div>


      <!-- SIDEBAR NAVIGATION -->
      <nav class="sidebar-nav">


        <a class="nav-link active" href="/admin/dashboard" aria-current="page">

          <span class="nav-icon">

            <i class="bi bi-speedometer2" aria-hidden="true"></i>

          </span>

          <span class="nav-text">
            Dashboard
          </span>

        </a>


        <a class="nav-link" href="/clientdata">

          <span class="nav-icon">

            <i class="bi bi-envelope" aria-hidden="true"></i>

          </span>

          <span class="nav-text">
            Contact Messages
          </span>

        </a>


        <a class="nav-link" href="#">

          <span class="nav-icon">

            <i class="bi bi-people" aria-hidden="true"></i>

          </span>

          <span class="nav-text">
            Users
          </span>

        </a>


        <a class="nav-link" href="#">

          <span class="nav-icon">

            <i class="bi bi-bar-chart-line" aria-hidden="true"></i>

          </span>

          <span class="nav-text">
            Analytics
          </span>

        </a>


        <a class="nav-link" href="#">

          <span class="nav-icon">

            <i class="bi bi-gear" aria-hidden="true"></i>

          </span>

          <span class="nav-text">
            Settings
          </span>

        </a>


      </nav>


      <!-- SIDEBAR USER -->
      <div class="sidebar-user">

        <div class="avatar-img avatar-md d-flex align-items-center justify-content-center bg-primary text-white">

          <i class="bi bi-person-fill"></i>

        </div>


        <strong>
          NexOrbiX Admin
        </strong>


        <small>
          <%= adminEmail %>
        </small>

      </div>


      <!-- SIDEBAR FOOTER -->
      <div class="sidebar-footer">

        <span class="status-dot"></span>

        <span class="sidebar-footer-text">
          System running smoothly
        </span>

      </div>


    </aside>


    <!-- ===================================== -->
    <!-- MAIN -->
    <!-- ===================================== -->

    <div class="admin-main">


      <!-- NAVBAR -->
      <nav class="navbar admin-navbar navbar-expand bg-white">

        <div class="container-fluid px-3 px-lg-4">


          <!-- MOBILE SIDEBAR BUTTON -->
          <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="adminSidebar" aria-expanded="true" aria-label="Toggle sidebar">

            <span></span>
            <span></span>
            <span></span>

          </button>


          <!-- SEARCH -->
          <form class="d-none d-md-flex ms-3 flex-grow-1" role="search">

            <input class="form-control search-input" type="search" placeholder="Search..." aria-label="Search">

          </form>


          <!-- NAVBAR ACTIONS -->
          <div class="navbar-actions ms-auto">


            <!-- THEME -->
            <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">

              <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>

            </button>


            <!-- NOTIFICATION -->
            <button class="icon-button" type="button" aria-label="Notifications" title="Notifications">

              <i class="bi bi-bell" aria-hidden="true"></i>

            </button>


            <!-- PROFILE -->
            <div class="dropdown">

              <button class="profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">

                <span class="avatar-img avatar-sm d-flex align-items-center justify-content-center bg-primary text-white">

                  <i class="bi bi-person-fill"></i>

                </span>


                <span class="profile-name d-none d-sm-inline">

                  NexOrbiX Admin

                </span>

              </button>


              <ul class="dropdown-menu dropdown-menu-end">


                <li>

                  <span class="dropdown-item-text">

                    <small class="text-muted">
                      Signed in as
                    </small>

                    <br>

                    <strong>
                      <%= adminEmail %>
                    </strong>

                  </span>

                </li>


                <li>
                  <hr class="dropdown-divider">
                </li>


                <li>

                  <a class="dropdown-item" href="/admin/logout">

                    <i class="bi bi-box-arrow-right me-2"></i>

                    Logout

                  </a>

                </li>

              </ul>

            </div>


          </div>

        </div>

      </nav>


      <!-- ===================================== -->
      <!-- DASHBOARD CONTENT -->
      <!-- ===================================== -->

      <main class="dashboard-content">

        <div class="container-fluid px-3 px-lg-4 py-4">


          <!-- PAGE HEADING -->
          <div class="page-heading">


            <div class="page-heading-copy">


              <span class="page-icon">

                <i class="bi bi-speedometer2" aria-hidden="true"></i>

              </span>


              <div>

                <p class="eyebrow mb-1">
                  NexOrbiX Administration
                </p>


                <h1 class="h3 mb-1">
                  Dashboard
                </h1>


                <p class="text-muted mb-0">
                  Welcome back. Manage your NexOrbiX website from here.
                </p>

              </div>


            </div>


          </div>


          <!-- ================================= -->
          <!-- METRICS -->
          <!-- ================================= -->

          <section class="row g-3 mt-1" aria-label="Dashboard metrics">


            <!-- WEBSITE -->
            <div class="col-12 col-sm-6 col-xl-3">

              <article class="metric-card metric-primary">

                <div class="metric-top">

                  <span class="metric-label">
                    Website
                  </span>

                  <span class="metric-icon">

                    <i class="bi bi-globe2" aria-hidden="true"></i>

                  </span>

                </div>


                <div class="metric-value">
                  Online
                </div>


                <div class="metric-meta">

                  <span class="text-success">
                    Active
                  </span>

                  <span>
                    NexOrbiX website
                  </span>

                </div>

              </article>

            </div>


            <!-- CONTACT -->
            <div class="col-12 col-sm-6 col-xl-3">

              <article class="metric-card metric-success">

                <div class="metric-top">

                  <span class="metric-label">
                    Contact Messages
                  </span>

                  <span class="metric-icon">

                    <i class="bi bi-envelope" aria-hidden="true"></i>

                  </span>

                </div>


                <div class="metric-value">
                  --
                </div>


                <div class="metric-meta">

                  <span>
                    Available
                  </span>

                  <span>
                    in Contact Messages
                  </span>

                </div>

              </article>

            </div>


            <!-- ADMIN -->
            <div class="col-12 col-sm-6 col-xl-3">

              <article class="metric-card metric-warning">

                <div class="metric-top">

                  <span class="metric-label">
                    Admin Users
                  </span>

                  <span class="metric-icon">

                    <i class="bi bi-person-check" aria-hidden="true"></i>

                  </span>

                </div>


                <div class="metric-value">
                  1
                </div>


                <div class="metric-meta">

                  <span>
                    Active
                  </span>

                  <span>
                    authorized account
                  </span>

                </div>

              </article>

            </div>


            <!-- SECURITY -->
            <div class="col-12 col-sm-6 col-xl-3">

              <article class="metric-card metric-info">

                <div class="metric-top">

                  <span class="metric-label">
                    Security
                  </span>

                  <span class="metric-icon">

                    <i class="bi bi-shield-check" aria-hidden="true"></i>

                  </span>

                </div>


                <div class="metric-value">
                  Secure
                </div>


                <div class="metric-meta">

                  <span class="text-success">
                    Protected
                  </span>

                  <span>
                    Admin authentication
                  </span>

                </div>

              </article>

            </div>


          </section>


          <!-- ================================= -->
          <!-- QUICK ACTIONS -->
          <!-- ================================= -->

          <section class="row g-3 mt-3">


            <div class="col-12 col-lg-8">

              <div class="card h-100">


                <div class="card-header">

                  <div>

                    <h5 class="mb-1">
                      Quick Actions
                    </h5>

                    <p class="text-muted mb-0">
                      Manage common NexOrbiX operations.
                    </p>

                  </div>

                </div>


                <div class="card-body">


                  <div class="row g-3">


                    <div class="col-12 col-md-6">

                      <a href="/clientdata" class="btn btn-outline-primary w-100 py-3">

                        <i class="bi bi-envelope me-2"></i>

                        View Contact Messages

                      </a>

                    </div>


                    <div class="col-12 col-md-6">

                      <a href="/" target="_blank" class="btn btn-outline-secondary w-100 py-3">

                        <i class="bi bi-globe me-2"></i>

                        View Website

                      </a>

                    </div>


                  </div>


                </div>

              </div>

            </div>


            <!-- ADMIN INFO -->
            <div class="col-12 col-lg-4">

              <div class="card h-100">


                <div class="card-header">

                  <h5 class="mb-0">
                    Admin Account
                  </h5>

                </div>


                <div class="card-body">


                  <div class="d-flex align-items-center mb-3">

                    <span class="avatar-img avatar-md d-flex align-items-center justify-content-center bg-primary text-white me-3">

                      <i class="bi bi-person-fill"></i>

                    </span>


                    <div>

                      <strong>
                        NexOrbiX Admin
                      </strong>

                      <br>

                      <small class="text-muted">
                        Administrator
                      </small>

                    </div>

                  </div>


                  <div class="small text-muted mb-1">
                    Email
                  </div>

                  <div class="fw-semibold mb-3">
                    <%= adminEmail %>
                  </div>


                  <a href="/admin/logout" class="btn btn-outline-danger btn-sm">

                    <i class="bi bi-box-arrow-right me-1"></i>

                    Logout

                  </a>


                </div>

              </div>

            </div>


          </section>


          <!-- ================================= -->
          <!-- SYSTEM STATUS -->
          <!-- ================================= -->

          <section class="row mt-3">


            <div class="col-12">

              <div class="card">


                <div class="card-body">


                  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between">


                    <div>

                      <h5 class="mb-1">
                        NexOrbiX System Status
                      </h5>

                      <p class="text-muted mb-0">
                        Your admin dashboard is protected and ready.
                      </p>

                    </div>


                    <div class="mt-3 mt-md-0">

                      <span class="badge bg-success">

                        <i class="bi bi-check-circle me-1"></i>

                        All Systems Operational

                      </span>

                    </div>


                  </div>


                </div>

              </div>

            </div>


          </section>


        </div>

      </main>


    </div>

  </div>


  <!-- Bootstrap JS -->
  <script src="/admin/assets/js/bootstrap.bundle.min.js"></script>

  <!-- AdminHMD JS -->
  <script src="/admin/assets/js/main.js"></script>


</body>

</html>