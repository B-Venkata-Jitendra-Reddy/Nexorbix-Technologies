<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="NexOrbiX Admin Login">

  <title><%= title %> | NexOrbiX</title>


  <!-- Bootstrap -->
  <link rel="stylesheet" href="/admin/assets/css/bootstrap.min.css">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="/admin/assets/vendors/bootstrap-icons/bootstrap-icons.css">

  <!-- AdminHMD Style -->
  <link rel="stylesheet" href="/admin/assets/css/style.css">

</head>


<body class="auth-body">


  <!-- Theme Toggle -->
  <button class="icon-button theme-toggle auth-theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme" title="Switch color theme">
    <i class="bi bi-moon-stars" data-theme-icon aria-hidden="true"></i>
  </button>


  <main class="auth-page">

    <section class="auth-card">


      <!-- BRAND -->
      <div class="auth-brand">

        <span class="brand-icon">
          <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
        </span>

        <span>

          <strong>NexOrbiX</strong>

          <small>
            Admin Dashboard
          </small>

        </span>

      </div>


      <!-- IMAGE -->
      <div class="auth-visual">

        <img src="/admin/assets/images/png/dasher-ui-bootstrap-5.jpg" alt="NexOrbiX Admin Dashboard">

      </div>


      <!-- LOGIN FORM -->
      <form action="/admin/login" method="POST" class="needs-validation" novalidate>


        <div class="mb-4">

          <p class="eyebrow mb-1">
            Secure Access
          </p>

          <h1 class="h3 mb-1">
            Admin Login
          </h1>

          <p class="text-muted mb-0">
            Sign in to your NexOrbiX admin workspace.
          </p>

        </div>


        <!-- ERROR -->
        <% if (error) { %>

        <div class="alert alert-danger d-flex align-items-center" role="alert">

          <i class="bi bi-exclamation-circle-fill me-2"></i>

          <span>
            <%= error %>
          </span>

        </div>

        <% } %>


        <!-- EMAIL -->
        <div class="mb-3">

          <label class="form-label" for="loginEmail">
            Email address
          </label>

          <input class="form-control" id="loginEmail" name="email" type="email" placeholder="Enter admin email" autocomplete="username" required>

          <div class="invalid-feedback">
            Enter a valid email address.
          </div>

        </div>


        <!-- PASSWORD -->
        <div class="mb-3">

          <label class="form-label" for="loginPassword">
            Password
          </label>

          <input class="form-control" id="loginPassword" name="password" type="password" placeholder="Enter admin password" autocomplete="current-password" required>

          <div class="invalid-feedback">
            Password is required.
          </div>

        </div>


        <!-- REMEMBER -->
        <div class="form-check mb-4">

          <input class="form-check-input" type="checkbox" id="rememberMe" disabled>

          <label class="form-check-label text-muted" for="rememberMe">
            Secure session enabled
          </label>

        </div>


        <!-- LOGIN BUTTON -->
        <button class="btn btn-primary w-100" type="submit">

          <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>

          Sign In

        </button>


      </form>


      <!-- FOOTER -->
      <div class="auth-footer">

        <span>
          © <%= new Date().getFullYear() %> NexOrbiX
        </span>

      </div>


    </section>

  </main>


  <!-- Bootstrap JS -->
  <script src="/admin/assets/js/bootstrap.bundle.min.js"></script>

  <!-- AdminHMD JS -->
  <script src="/admin/assets/js/main.js"></script>


  <!-- Bootstrap Validation -->
  <script>
    (() => {

      "use strict";

      const forms =
        document.querySelectorAll(".needs-validation");

      Array.from(forms).forEach((form) => {

        form.addEventListener(
          "submit",
          (event) => {

            if (!form.checkValidity()) {

              event.preventDefault();
              event.stopPropagation();

            }

            form.classList.add("was-validated");

          },
          false
        );

      });

    })();
  </script>

</body>

</html>