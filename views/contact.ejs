<!-- Contact Section -->
<section id="contact" class="contact section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">

        <h2>Let's Build What's Next</h2>

        <p>
            Have a business challenge, product idea, or technology requirement?
            Tell us what you're working on and let's explore how NexOrbiX can help.
        </p>

    </div>
    <!-- End Section Title -->


    <div class="container"
         data-aos="fade-up"
         data-aos-delay="100">

        <div class="row gy-5 align-items-stretch">


            <!-- =========================================
                 CONTACT INFORMATION
            ========================================== -->

            <div class="col-lg-5"
                 data-aos="fade-right"
                 data-aos-delay="200">

                <div class="info-panel">

                    <div class="panel-header">

                        <span class="section-badge">

                            <i class="bi bi-chat-dots-fill"></i>

                            GET IN TOUCH

                        </span>

                        <h3>
                            Let's Bring Your Idea to Life
                        </h3>

                        <p>
                            Whether you're building a new digital product,
                            improving an existing business process, or looking
                            for the right technology partner, we're here to
                            understand your requirements and explore the
                            possibilities with you.
                        </p>

                    </div>


                    <!-- Contact Methods -->

                    <div class="contact-methods">


                        <!-- Email -->

                        <div class="method-item">

                            <div class="method-icon">
                                <i class="bi bi-envelope-paper-fill"></i>
                            </div>

                            <div class="method-details">

                                <span class="method-label">
                                    Email Us
                                </span>

                                <a href="mailto:contact.nexorbix@gmail.com">
                                    contact.nexorbix@gmail.com
                                </a>

                            </div>

                        </div>


                        <!-- Phone -->

                        <div class="method-item">

                            <div class="method-icon">
                                <i class="bi bi-headset"></i>
                            </div>

                            <div class="method-details">

                                <span class="method-label">
                                    Call Us
                                </span>

                                <a href="tel:+919481437557">
                                    +91 948 143 7557
                                </a>

                            </div>

                        </div>


                        <!-- Location -->

                        <div class="method-item">

                            <div class="method-icon">
                                <i class="bi bi-pin-map-fill"></i>
                            </div>

                            <div class="method-details">

                                <span class="method-label">
                                    Location
                                </span>

                                <span>
                                    Bengaluru, Karnataka, India
                                </span>

                            </div>

                        </div>


                    </div>


                    <!-- Contact Highlights -->

                    <div class="stats-strip">

                        <div class="stat-item">
                            <span class="stat-text">
                                Product Focused
                            </span>
                        </div>

                        <div class="stat-item">
                            <span class="stat-text">
                                Practical Solutions
                            </span>
                        </div>

                        <div class="stat-item">
                            <span class="stat-text">
                                Long-Term Thinking
                            </span>
                        </div>

                    </div>


                    <!-- Social -->

                    <div class="social-connect">

                        <span>
                            Follow Us
                        </span>

                        <div class="social-icons">

                            <a
                                href="https://www.instagram.com/nexorbix.official"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Instagram">

                                <i class="bi bi-instagram"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>
            <!-- End Info Panel -->


            <!-- =========================================
                 CONTACT FORM
            ========================================== -->

            <div class="col-lg-7"
                 data-aos="fade-left"
                 data-aos-delay="300">

                <div class="form-card">


                    <!-- Form Header -->

                    <div class="form-card-header">

                        <div class="header-icon">

                            <i class="bi bi-send-fill"></i>

                        </div>

                        <div class="header-text">

                            <h4>
                                Start a Conversation
                            </h4>

                            <p>
                                Tell us a little about what you're looking
                                to build or achieve.
                            </p>

                        </div>

                    </div>


                    <!-- Form -->

                    <form
                        action="/contact"
                        method="POST"
                        class="php-email-form">

                        <div class="row g-4">


                            <!-- Full Name -->

                            <div class="col-md-6">

                                <div class="input-group-custom">

                                    <label>
                                        Your Full Name
                                    </label>

                                    <div class="input-wrapper">

                                        <i class="bi bi-person"></i>

                                        <input
                                            type="text"
                                            name="name"
                                            placeholder="John Doe"
                                            required>

                                    </div>

                                </div>

                            </div>


                            <!-- Email -->

                            <div class="col-md-6">

                                <div class="input-group-custom">

                                    <label>
                                        Email Address
                                    </label>

                                    <div class="input-wrapper">

                                        <i class="bi bi-envelope"></i>

                                        <input
                                            type="email"
                                            name="email"
                                            placeholder="john@example.com"
                                            required>

                                    </div>

                                </div>

                            </div>


                            <!-- Phone -->

                            <div class="col-md-6">

                                <div class="input-group-custom">

                                    <label>
                                        Phone Number
                                    </label>

                                    <div class="input-wrapper">

                                        <i class="bi bi-telephone"></i>

                                        <input
                                            type="tel"
                                            name="phone"
                                            placeholder="+91 XXXXX XXXXX"
                                            required>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================
                                 INTEREST SELECT
                            ================================== -->

                            <div class="col-md-6">

                                <div class="input-group-custom">

                                    <label for="interest">
                                        I'm Interested In
                                    </label>

                                    <div class="input-wrapper select-wrapper">

                                        <i class="bi bi-grid"></i>

                                        <select
                                            id="interest"
                                            name="subject"
                                            required>

                                            <option value="" selected disabled>
                                                Select an option
                                            </option>

                                            <option value="web-development">
                                                Web & Digital Products
                                            </option>

                                            <option value="custom-software">
                                                Custom Software & MVP
                                            </option>

                                            <option value="ai-solutions">
                                                AI & Intelligent Solutions
                                            </option>

                                            <option value="automation">
                                                Automation & Integrations
                                            </option>

                                            <option value="ui-ux">
                                                UI/UX & Product Design
                                            </option>

                                            <option value="digital-marketing">
                                                Digital Marketing
                                            </option>

                                            <option value="brand-strategy">
                                                Brand & Strategy
                                            </option>

                                            <option value="internship">
                                                Internship
                                            </option>

                                            <option value="other">
                                                Other
                                            </option>

                                        </select>

                                    </div>

                                </div>

                            </div>


                            <!-- Message -->

                            <div class="col-12">

                                <div class="input-group-custom">

                                    <label>
                                        Your Message
                                    </label>

                                    <div class="input-wrapper textarea-wrapper">

                                        <i class="bi bi-pencil-square"></i>

                                        <textarea
                                            name="message"
                                            rows="5"
                                            placeholder="Tell us about your idea, requirement, or question..."
                                            required></textarea>

                                    </div>

                                </div>

                            </div>


                        </div>


                        <!-- Form Actions -->

                        <div class="form-actions">

                            <button
                                type="submit"
                                class="btn-submit">

                                <span>
                                    Send Message
                                </span>

                                <i class="bi bi-arrow-right-circle-fill"></i>

                            </button>


                            <div class="secure-note">

                                <i class="bi bi-lock-fill"></i>

                                <span>
                                    Your information is kept secure
                                </span>

                            </div>

                        </div>


                    </form>

                </div>

            </div>
            <!-- End Form Card -->


        </div>

    </div>

</section>
<!-- /Contact Section -->