    border-radius: 11px;
    background: #f0f8f7;
    color: #38524f;
    font-size: 12px;
    line-height: 1.6;
    cursor: pointer;
  }

  .nx-declaration input {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .nx-modal-footer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
    padding-top: 17px;
    border-top: 1px solid #edf1f0;
  }

  .nx-back-button,
  .nx-next-button {
    padding: 11px 16px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
  }

  .nx-back-button {
    border: 1px solid #dce6e4;
    background: #fff;
    color: #506663;
  }

  .nx-next-button {
    border: 1px solid var(--nx-teal);
    background: var(--nx-teal);
    color: #fff;
  }

  .nx-next-button:hover {
    background: var(--nx-teal-dark);
  }

  .nx-next-button:disabled {
    cursor: wait;
    opacity: .65;
  }

  .nx-footer-spacer {
    flex: 1;
  }

  .nx-form-error {
    margin-top: 12px;
    color: #b42318;
    font-size: 12px;
  }

  .nx-form-error:empty {
    display: none;
  }

  .nx-privacy-note {
    margin-top: 12px;
    color: #9aa7a5;
    font-size: 10px;
    text-align: right;
  }

  .nx-success-state {
    padding: 20px 0;
    text-align: center;
  }

  .nx-success-icon {
    color: var(--nx-teal);
    font-size: 42px;
  }

  .nx-success-state h3 {
    color: #203a38;
  }

  .nx-success-state p {
    color: #71817f;
    font-size: 13px;
    line-height: 1.7;
  }

  .nx-registration-id {
    margin: 12px auto;
    padding: 12px;
    border-radius: 9px;
    background: #f0f8f7;
    font-size: 12px;
  }

  body.nx-modal-open {
    overflow: hidden;
  }

  @keyframes nxFade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media(max-width:600px) {
    .nx-modal {
      padding: 8px;
    }

    .nx-modal-dialog {
      max-height: 95dvh;
      padding: 22px 16px;
      border-radius: 16px;
    }

    .nx-form-grid {
      grid-template-columns: 1fr;
    }

    .nx-full {
      grid-column: auto;
    }

    .nx-modal-footer {
      position: sticky;
      bottom: -1px;
      padding: 12px 0 4px;
      background: #fff;
    }

    .nx-back-button,
    .nx-next-button {
      padding: 11px 12px;
    }
  }
</style>


<script>

  (() => {
    const modal = document.getElementById("nxInternshipModal");
    if (!modal || modal.dataset.initialized) return;
    modal.dataset.initialized = "true";

    const form = document.getElementById("nxInternshipForm");
    const dialog = modal.querySelector(".nx-modal-dialog");
    const steps = [...form.querySelectorAll(".nx-form-step")];
    const back = document.getElementById("nxBackBtn");
    const next = document.getElementById("nxNextBtn");
    const submit = document.getElementById("nxSubmitBtn");
    const error = document.getElementById("nxFormError");
    const progress = document.getElementById("nxProgressBar");
    const stepLabel = document.getElementById("nxStepLabel");
    const percent = document.getElementById("nxStepPercent");
    const degree = document.getElementById("nxDegree");
    const otherWrap = document.getElementById("nxOtherDegreeWrap");
    const otherDegree = document.getElementById("nxOtherDegree");
    const experienceWrap = document.getElementById("nxExperienceWrap");
    const experienceDetails = document.getElementById("nxExperienceDetails");

    let current = 0;
    let submitting = false;

    function showStep(index) {
      current = index;
      steps.forEach((step, i) => step.classList.toggle("is-active", i === index));

      const amount = Math.round(((index + 1) / steps.length) * 100);
      progress.style.width = `${amount}%`;
      stepLabel.textContent = `Step ${index + 1} of ${steps.length}`;
      percent.textContent = `${amount}% complete`;
      back.hidden = index === 0;
      next.hidden = index === steps.length - 1;
      submit.hidden = index !== steps.length - 1;
      error.textContent = "";
      dialog.scrollTop = 0;
    }

    function openModal(event) {
      event?.preventDefault();
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("nx-modal-open");
      showStep(0);
      setTimeout(() => form.elements.fullName.focus(), 30);
    }

    function closeModal() {
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("nx-modal-open");
    }

    document.addEventListener("click", event => {
      const opener = event.target.closest(".js-open-internship-modal");
      if (opener) openModal(event);
    });

    modal.querySelectorAll("[data-close-modal]").forEach(button =>
      button.addEventListener("click", closeModal)
    );

    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && modal.getAttribute("aria-hidden") === "false") {
        closeModal();
      }
    });

    function validateStep() {
      error.textContent = "";
      const fields = [...steps[current].querySelectorAll("input, select, textarea")]
        .filter(field => !field.disabled && field.offsetParent !== null);

      const radioNames = new Set();

      for (const field of fields) {
        if (field.type === "radio") {
          if (radioNames.has(field.name)) continue;
          radioNames.add(field.name);

          const group = fields.filter(item =>
            item.type === "radio" && item.name === field.name
          );

          if (group.some(item => item.required) && !group.some(item => item.checked)) {
            error.textContent = "Please select an option to continue.";
            group[0].focus();
            return false;
          }
        } else if (!field.checkValidity()) {
          field.reportValidity();
          field.focus();
          return false;
        }
      }

      return true;
    }

    next.addEventListener("click", () => {
      if (validateStep()) showStep(Math.min(current + 1, steps.length - 1));
    });

    back.addEventListener("click", () => showStep(Math.max(current - 1, 0)));

    degree.addEventListener("change", () => {
      const isOther = degree.value === "Other";
      otherWrap.classList.toggle("nx-hidden", !isOther);
      otherDegree.required = isOther;
      if (!isOther) otherDegree.value = "";
    });

    form.querySelectorAll('[name="hasExperience"]').forEach(radio => {
      radio.addEventListener("change", () => {
        const has = radio.checked && radio.value === "Yes";
        experienceWrap.classList.toggle("nx-hidden", !has);
        experienceDetails.required = has;
        if (!has) experienceDetails.value = "";
      });
    });

    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, char => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;",
        '"': "&quot;", "'": "&#39;"
      })[char]);
    }

    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (submitting || !validateStep()) return;

      submitting = true;
      submit.disabled = true;
      submit.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Saving registration...';
      error.textContent = "";

      const payload = Object.fromEntries(new FormData(form).entries());
      payload.declaration = form.elements.declaration.checked;

      try {
        const response = await fetch("/internships/register", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify(payload)
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Unable to save your registration. Please try again.");
        }

        // Only show success after the backend confirms MongoDB insertion.
        steps[current].innerHTML = `
        <div class="nx-success-state">
          <div class="nx-success-icon"><i class="bi bi-check-circle-fill"></i></div>
          <h3>Registration successful!</h3>
          <p>${escapeHTML(result.message || "Your registration has been saved.")}</p>
          <div class="nx-registration-id">
            Registration ID:
            <strong>${escapeHTML(result.registrationId || "")}</strong>
          </div>
          <p>Join the official WhatsApp group for internship updates and announcements.</p>
          <button type="button" class="nx-next-button" id="nxDoneBtn">Done</button>
        </div>`;

        next.hidden = true;
        back.hidden = true;
        submit.hidden = true;
        progress.style.width = "100%";
        stepLabel.textContent = "Registration complete";
        percent.textContent = "100% complete";

        document.getElementById("nxDoneBtn").addEventListener("click", closeModal);
      } catch (err) {
        error.textContent = err.message || "A network error occurred. Please try again.";
      } finally {
        submitting = false;
        submit.disabled = false;
        submit.innerHTML = 'Submit Registration <i class="bi bi-check2"></i>';
      }
    });
  })();

</script>