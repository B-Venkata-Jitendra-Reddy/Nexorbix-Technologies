<!-- NexOrbiX Internship Registration Modal -->
<div class="nx-modal" id="nxInternshipModal" aria-hidden="true">
  <div class="nx-modal-backdrop" data-close-modal></div>

  <section class="nx-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="nxModalTitle" tabindex="-1">

    <button type="button" class="nx-modal-close" aria-label="Close registration" data-close-modal>
      <i class="bi bi-x-lg"></i>
    </button>

    <div class="nx-modal-brand">
      <span class="nx-brand-mark"><i class="bi bi-stars"></i></span>
      <span>NexOrbiX<small>TECHNOLOGIES</small></span>
    </div>

    <header class="nx-modal-heading">
      <span class="nx-step-kicker">INTERNSHIP REGISTRATION</span>
      <h2 id="nxModalTitle">Your next step starts here.</h2>
      <p>Complete four quick steps to register for an internship.</p>
    </header>

    <div class="nx-progress"><span id="nxProgressBar"></span></div>
    <div class="nx-step-meta">
      <span id="nxStepLabel">Step 1 of 4</span>
      <span id="nxStepPercent">25% complete</span>
    </div>

    <form id="nxInternshipForm" novalidate>

      <!-- STEP 1: PERSONAL DETAILS -->
      <div class="nx-form-step is-active" data-step="0">
        <h3>Let's get to know you</h3>
        <p class="nx-step-description">Your personal and contact details.</p>

        <div class="nx-form-grid">
          <label>Full Name *
            <input name="fullName" autocomplete="name" minlength="2" maxlength="100" required
              placeholder="Your full name">
          </label>

          <label>Email Address *
            <input name="email" type="email" autocomplete="email" maxlength="254" required
              placeholder="you@example.com">
          </label>

          <label>Phone Number *
            <input name="phone" type="tel" inputmode="tel" autocomplete="tel" pattern="[0-9+()\- ]{7,18}" required
              placeholder="+91 98765 43210">
          </label>

          <label>City *
            <input name="city" autocomplete="address-level2" maxlength="100" required placeholder="Your city">
          </label>

          <label class="nx-full">Current Status *
            <select name="currentStatus" required>
              <option value="">Select your current status</option>
              <option>Student</option>
              <option>Graduate</option>
              <option>Fresher</option>
            </select>
          </label>
        </div>
      </div>

      <!-- STEP 2: EDUCATION AND DOMAIN -->
      <div class="nx-form-step" data-step="1">
        <h3>Your education &amp; interests</h3>
        <p class="nx-step-description">Choose your academic background and track.</p>

        <div class="nx-form-grid">
          <label>Course / Degree *
            <select name="degree" id="nxDegree" required>
              <option value="">Choose your degree</option>
              <option>BCA</option>
              <option>MCA</option>
              <option>B.Tech</option>
              <option>M.Tech</option>
              <option value="Other">Others</option>
            </select>
          </label>

          <label id="nxOtherDegreeWrap" class="nx-hidden">
            Specify Degree *
            <input name="otherDegree" id="nxOtherDegree" maxlength="100" placeholder="Enter your degree">
          </label>

          <label class="nx-full">College Name *
            <input name="college" required maxlength="200" placeholder="Your college or institution">
          </label>

          <label class="nx-full">Field of Study *
            <input name="fieldOfStudy" required maxlength="150" placeholder="e.g. Computer Applications">
          </label>

          <label class="nx-full">Preferred Internship Domain *
            <select name="preferredDomain" required>
              <option value="">Select your preferred domain</option>
              <option>AI &amp; Generative AI</option>
              <option>Full Stack Web Development</option>
              <option>Python Development</option>
              <option>Machine Learning</option>
              <option>Cyber Security</option>
              <option>Cloud Computing</option>
              <option>Data Analytics &amp; Business Intelligence</option>
            </select>
          </label>
        </div>
      </div>

      <!-- STEP 3: SKILLS AND SETUP -->
      <div class="nx-form-step" data-step="2">
        <h3>Skills &amp; setup</h3>
        <p class="nx-step-description">Tell us about your skills and experience.</p>

        <div class="nx-form-grid">
          <label class="nx-full">List Your Skills *
            <textarea name="skills" rows="3" minlength="2" maxlength="2000" required
              placeholder="HTML, JavaScript, Python, communication..."></textarea>
            <small>Separate your skills with commas.</small>
          </label>

          <fieldset class="nx-full">
            <legend>Do you have prior experience? *</legend>
            <div class="nx-radio-row">
              <label><input type="radio" name="hasExperience" value="Yes" required> Yes</label>
              <label><input type="radio" name="hasExperience" value="No" required> No</label>
            </div>
          </fieldset>

          <label class="nx-full nx-hidden" id="nxExperienceWrap">
            Describe Your Experience *
            <textarea name="experienceDetails" id="nxExperienceDetails" rows="3" maxlength="3000"
              placeholder="Describe your projects or previous internships"></textarea>
          </label>

          <fieldset class="nx-full">
            <legend>Do you have a laptop and stable internet connection? *</legend>
            <div class="nx-radio-row">
              <label><input type="radio" name="setup" value="Yes" required> Yes</label>
              <label><input type="radio" name="setup" value="No" required> No</label>
              <label><input type="radio" name="setup" value="Maybe" required> Maybe</label>
            </div>
          </fieldset>
        </div>
      </div>

      <!-- STEP 4: ONBOARDING AND DECLARATION -->
      <div class="nx-form-step" data-step="3">
        <h3>One last step!</h3>
        <p class="nx-step-description">Complete these onboarding steps.</p>

        <div class="nx-action-card">
          <span class="nx-action-icon"><i class="bi bi-linkedin"></i></span>
          <div>
            <strong>Follow NexOrbiX on LinkedIn</strong>
            <p>Stay connected for internship announcements.</p>
            <a href="https://www.linkedin.com/company/145206254/" target="_blank" rel="noopener noreferrer">
              Visit LinkedIn page <i class="bi bi-arrow-up-right"></i>
            </a>
          </div>
        </div>

        <div class="nx-whatsapp-notice">
          <div class="nx-notice-title">
            <i class="bi bi-whatsapp"></i>
            Official WhatsApp Group <b>Mandatory</b>
          </div>
          <p>
            Joining the WhatsApp group is mandatory. All internship updates,
            exam details, roll numbers, schedules, offer letters, project tasks,
            and other important announcements will be shared only through the
            WhatsApp group. If you do not join the group, you may miss
            important information related to your internship.
          </p>
          <a href="https://chat.whatsapp.com/D8a5tnX6azLIj4bSLgj98O?s=cl&p=a&mlu=4&ilr=4" target="_blank"
            rel="noopener noreferrer">
            Join WhatsApp Group <i class="bi bi-arrow-up-right"></i>
          </a>
        </div>

        <div class="nx-action-card">
          <span class="nx-action-icon"><i class="bi bi-patch-check"></i></span>
          <div>
            <strong>Entry-Level Assessment</strong>
            <p>An assessment will be provided as part of the entry-level internship selection process.</p>
            <a href="https://forms.gle/Y4wS3N71ETnggo748" target="_blank" rel="noopener noreferrer">
              Open Assessment Link <i class="bi bi-arrow-up-right"></i>
            </a>
          </div>
        </div>

        <label class="nx-declaration">
          <input type="checkbox" name="declaration" required>
          <span>I confirm that all the information provided by me is correct. *</span>
        </label>
      </div>

      <div id="nxFormError" class="nx-form-error" role="alert" aria-live="polite"></div>

      <div class="nx-modal-footer">
        <button type="button" id="nxBackBtn" class="nx-back-button" hidden>
          <i class="bi bi-arrow-left"></i> Back
        </button>
        <span class="nx-footer-spacer"></span>
        <button type="button" id="nxNextBtn" class="nx-next-button">
          Next <i class="bi bi-arrow-right"></i>
        </button>
        <button type="submit" id="nxSubmitBtn" class="nx-next-button" hidden>
          Submit Registration <i class="bi bi-check2"></i>
        </button>
      </div>

      <p class="nx-privacy-note">Your information is collected for internship registration.</p>
    </form>
  </section>
</div>



